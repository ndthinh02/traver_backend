PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/traver?replicaSet=rs0
JWT_ACCESS_SECRET=replace-with-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
OTP_PEPPER=replace-with-another-random-secret-at-least-32-characters

# Real email: use SMTP settings from your provider (Gmail example: smtp.gmail.com).
# Gmail SMTP_PASS must be an App Password, never your regular account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PUBLIC_BASE_URL=http://10.0.2.2:8080
NODE_ENV=development
MAIL_MODE=smtp

BOOKING_HOLD_MINUTES=15
BOOKING_CLEANUP_SECONDS=30
ENABLE_PAYMENT_SIMULATION=false
